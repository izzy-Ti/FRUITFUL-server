// use prisma-8

model User {
  id        String   @id
  email     String   @unique
  name      String?
  role      String   @default("job_seeker")
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model JobSeekerProfile {
  id          String   @id
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline    String?
  photoUrl    String?
  bio         String?
  location    String?
  phone       String?
  cvUrl       String?
  languages   String[]
  visibility  String   @default("public")
  isAvailable Boolean  @default(true)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model PortfolioProject {
  id          String   @id
  profileId   String
  profile     JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String?
  projectUrl  String?
  repoUrl     String?
  images      String[]
  documents   String[]
  links       String[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([profileId])
}

model EmployerProfile {
  id                 String   @id
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  logoUrl            String?
  description        String?
  industry           String?
  companySize        String?
  websiteUrl         String?
  location           String?
  contactEmail       String?
  contactPhone       String?
  verificationStatus String   @default("pending")
  verifiedAt         TimestamptzString?
  rejectionReason    String?
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  @@index([verificationStatus])
}

model EducationRecord {
  id           String   @id
  profileId    String
  profile      JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    String
  endDate      String?
  isCurrent    Boolean  @default(false)
  description  String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([profileId])
}

model ExperienceRecord {
  id             String   @id
  profileId      String
  profile        JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title          String
  company        String
  location       String?
  employmentType String?
  startDate      String
  endDate        String?
  isCurrent      Boolean  @default(false)
  description    String?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([profileId])
}

model Skill {
  id        String   @id
  name      String   @unique
  category  String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model ProfileSkill {
  id                String   @id
  profileId         String
  profile           JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId           String
  skill             Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level             String?
  yearsOfExperience Int?
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  @@unique([profileId, skillId])
  @@index([profileId])
  @@index([skillId])
}

model VerificationRecord {
  id          String   @id
  employerId  String
  employer    EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  status      String
  reviewerId  String?
  notes       String?
  createdAt   TimestamptzString @default(now())

  @@index([employerId])
  @@index([status])
}

model FileMetadata {
  id           String   @id
  uploadedById String?
  user         User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  fileName     String
  originalName String
  mimeType     String
  size         Int
  url          String
  secureUrl    String?
  publicId     String?
  entityType   String?
  entityId     String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([uploadedById])
  @@index([entityType])
}

model Job {
  id               String   @id
  employerId       String
  employer         EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title            String
  description      String
  requirements     String?
  responsibilities String?
  category         String?
  employmentType   String   @default("full_time")
  workplaceType    String   @default("on_site")
  location         String?
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String?  @default("USD")
  experienceLevel  String?
  skills           String[]
  status           String   @default("draft")
  publishedAt      TimestamptzString?
  closedAt         TimestamptzString?
  deadline         String?
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@index([employerId])
  @@index([status])
  @@index([employmentType])
  @@index([workplaceType])
  @@index([category])
}
