// use prisma-8

model User {
  id               String   @id
  email            String   @unique
  name             String?
  role             String   @default("job_seeker")
  status           String   @default("active")
  suspendedAt      TimestamptzString?
  suspensionReason String?
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@index([status])
  @@index([role])
}

model JobSeekerProfile {
  id          String   @id
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline    String?
  photoUrl    String?
  bio         String?
  location    String?
  latitude    Float?
  longitude   Float?
  phone       String?
  cvUrl       String?
  languages   String[]
  visibility     String   @default("public")
  isAvailable    Boolean  @default(true)
  approvalStatus String   @default("approved")
  approvedAt     TimestamptzString?
  adminNotes     String?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([approvalStatus])
}

model PortfolioProject {
  id               String   @id
  profileId        String
  profile          JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  category         String?
  projectUrl       String?
  repoUrl          String?
  images           String[]
  documents        String[]
  links            String[]
  moderationStatus String   @default("approved")
  adminNotes       String?
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@index([profileId])
  @@index([moderationStatus])
}

model EmployerProfile {
  id                 String   @id
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  logoUrl            String?
  description        String?
  industry           String?
  companySize        String?
  websiteUrl         String?
  location           String?
  contactEmail       String?
  contactPhone       String?
  verificationStatus String   @default("pending")
  verifiedAt         TimestamptzString?
  rejectionReason    String?
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  @@index([verificationStatus])
}

model EducationRecord {
  id           String   @id
  profileId    String
  profile      JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    String
  endDate      String?
  isCurrent    Boolean  @default(false)
  description  String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([profileId])
}

model ExperienceRecord {
  id             String   @id
  profileId      String
  profile        JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title          String
  company        String
  location       String?
  employmentType String?
  startDate      String
  endDate        String?
  isCurrent      Boolean  @default(false)
  description    String?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([profileId])
}

model Skill {
  id        String   @id
  name      String   @unique
  category  String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model ProfileSkill {
  id                String   @id
  profileId         String
  profile           JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId           String
  skill             Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level             String?
  yearsOfExperience Int?
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  @@unique([profileId, skillId])
  @@index([profileId])
  @@index([skillId])
}

model VerificationRecord {
  id          String   @id
  employerId  String
  employer    EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  status      String
  reviewerId  String?
  notes       String?
  createdAt   TimestamptzString @default(now())

  @@index([employerId])
  @@index([status])
}

model FileMetadata {
  id           String   @id
  uploadedById String?
  user         User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  fileName     String
  originalName String
  mimeType     String
  size         Int
  url          String
  secureUrl    String?
  publicId     String?
  entityType   String?
  entityId     String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([uploadedById])
  @@index([entityType])
}

model Job {
  id               String   @id
  employerId       String
  employer         EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title            String
  description      String
  requirements     String?
  responsibilities String?
  category         String?
  employmentType   String   @default("full_time")
  workplaceType    String   @default("on_site")
  location         String?
  latitude         Float?
  longitude        Float?
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String?  @default("USD")
  experienceLevel  String?
  skills           String[]
  status           String   @default("draft")
  publishedAt      TimestamptzString?
  closedAt         TimestamptzString?
  deadline         String?
  adminNotes       String?
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@index([employerId])
  @@index([status])
  @@index([employmentType])
  @@index([workplaceType])
  @@index([category])
}

model JobApplication {
  id             String   @id
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  profileId      String
  profile        JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  status         String   @default("submitted")
  stageId        String?
  stage          PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  rating         Int?
  stageMovedAt   TimestamptzString?
  tags           String[] @default([])
  coverLetter         String?
  cvUrl               String?
  portfolioLinks      String[]
  employerNotes       String?
  rejectionReasonCode String?
  rejectionCategory   String?
  rejectionFeedback   String?
  rejectedAt          TimestamptzString?
  appliedAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()

  @@unique([jobId, profileId])
  @@index([jobId])
  @@index([profileId])
  @@index([status])
  @@index([stageId])
  @@index([rejectionReasonCode])
}

model ApplicationStatusHistory {
  id             String   @id
  applicationId  String
  application    JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousStatus String?
  newStatus      String
  changedById    String?
  changedByRole  String?
  notes          String?
  createdAt      TimestamptzString @default(now())

  @@index([applicationId])
  @@index([newStatus])
}

model Category {
  id           String   @id
  name         String   @unique
  slug         String   @unique
  description  String?
  icon         String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([isActive])
  @@index([displayOrder])
}

model ControlledData {
  id           String   @id
  category     String
  key          String
  label        String
  value        String?
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  isSystem     Boolean  @default(false)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([category, key])
  @@index([category])
  @@index([isActive])
}

model AuditLog {
  id           String   @id
  adminId      String
  adminEmail   String?
  action       String
  targetEntity String
  targetId     String
  details      String?
  ipAddress    String?
  createdAt    TimestamptzString @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetEntity])
  @@index([targetId])
  @@index([createdAt])
}

model Notification {
  id                  String   @id
  userId              String
  type                String
  title               String
  message             String
  data                String?
  read                Boolean  @default(false)
  readAt              TimestamptzString?
  emailSent           Boolean  @default(false)
  emailDeliveryStatus String?
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()

  @@index([userId])
  @@index([userId, read])
  @@index([type])
  @@index([createdAt])
}

model SavedSearch {
  id             String   @id
  userId         String
  title          String
  type           String
  filters        String
  alertFrequency String   @default("daily")
  isActive       Boolean  @default(true)
  lastNotifiedAt TimestamptzString?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([userId])
  @@index([type])
  @@index([alertFrequency])
  @@index([isActive])
}

model SavedCandidate {
  id         String   @id
  employerId String
  employer   EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  profileId  String
  profile    JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  notes      String?
  tags       String[]
  createdAt  TimestamptzString @default(now())

  @@unique([employerId, profileId])
  @@index([employerId])
  @@index([profileId])
}

model Conversation {
  id            String   @id
  employerId    String
  employer      EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  jobSeekerId   String
  jobSeeker     JobSeekerProfile @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  jobId         String?
  job           Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  status        String   @default("active")
  lastMessageAt TimestamptzString?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@unique([employerId, jobSeekerId])
  @@index([employerId])
  @@index([jobSeekerId])
  @@index([status])
  @@index([lastMessageAt])
}

model Message {
  id             String   @id
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean  @default(false)
  readAt         TimestamptzString?
  isModerated    Boolean  @default(false)
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isRead])
}

model MessageAttachment {
  id        String   @id
  messageId String
  message   Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileId    String?
  file      FileMetadata? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  url       String
  fileName  String
  fileSize  Int
  mimeType  String
  createdAt TimestamptzString @default(now())

  @@index([messageId])
}

model MessageReport {
  id           String   @id
  messageId    String
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason       String
  details      String?
  status       String   @default("pending")
  reviewedById String?
  reviewedBy   User?    @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   TimestamptzString?
  adminNotes   String?
  actionTaken  String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([messageId])
  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
}

model PipelineStage {
  id          String   @id
  employerId  String
  employer    EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  order       Int      @default(0)
  color       String   @default("#3b82f6")
  stageType   String   @default("interview")
  description String?
  isDefault   Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([employerId])
  @@index([jobId])
  @@index([order])
}

model CandidateNote {
  id            String   @id
  employerId    String
  employer      EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  profileId     String
  profile       JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  applicationId String?
  application   JobApplication?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content       String
  category      String   @default("general")
  rating        Int?
  isPinned      Boolean  @default(false)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([employerId])
  @@index([profileId])
  @@index([applicationId])
  @@index([authorId])
  @@index([createdAt])
}

model InternalComment {
  id            String   @id
  employerId    String
  employer      EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applicationId String
  application   JobApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        InternalComment? @relation(fields: [parentId], references: [id], onDelete: Cascade)
  content       String
  mentions      String[] @default([])
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([applicationId])
  @@index([employerId])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
}

model JobInterview {
  id                    String   @id
  applicationId         String
  application           JobApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employerId            String
  employer              EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  candidateId           String
  candidate             JobSeekerProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId                 String
  job                   Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title                 String
  interviewType         String   @default("video")
  status                String   @default("scheduled")
  startTime             TimestamptzString
  endTime               TimestamptzString
  timezone              String   @default("UTC")
  meetingLink           String?
  location              String?
  interviewerIds        String[] @default([])
  notes                 String?
  candidateInstructions String?
  rating                Int?
  feedbackSummary       String?
  cancellationReason    String?
  reminderSent24h       Boolean  @default(false)
  reminderSent1h        Boolean  @default(false)
  reminderSent15m       Boolean  @default(false)
  rescheduledCount      Int      @default(0)
  rescheduledFrom       TimestamptzString?
  rescheduledReason     String?
  cancelledBy           String?
  cancelledAt           TimestamptzString?
  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()

  @@index([applicationId])
  @@index([employerId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([startTime])
}

model JobOffer {
  id                String   @id
  applicationId     String
  application       JobApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employerId        String
  employer          EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  candidateId       String
  candidate         JobSeekerProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId             String
  job               Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status            String   @default("draft")
  salary            Float
  currency          String   @default("USD")
  salaryPeriod      String   @default("yearly")
  startDate         String
  expiryDate        TimestamptzString?
  benefits          String[] @default([])
  offerLetterUrl    String?
  notes             String?
  candidateFeedback String?
  sentAt            TimestamptzString?
  respondedAt       TimestamptzString?
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  @@index([applicationId])
  @@index([employerId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
}

model RejectionReason {
  id                   String   @id
  employerId           String?
  employer             EmployerProfile? @relation(fields: [employerId], references: [id], onDelete: Cascade)
  code                 String
  label                String
  category             String
  description          String?
  defaultEmailTemplate String?
  isSystem             Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            TimestamptzString @default(now())
  updatedAt            temporal.updatedAtString()

  @@index([employerId])
  @@index([code])
  @@index([category])
}

model InterviewerAvailability {
  id                  String   @id
  employerId          String
  employer            EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  userId              String?
  timezone            String   @default("UTC")
  weeklySchedule      String   @default("[]")
  dateOverrides       String   @default("[]")
  slotDurationMinutes Int      @default(45)
  bufferMinutes       Int      @default(15)
  minNoticeHours      Int      @default(24)
  maxInterviewsPerDay Int      @default(6)
  isActive            Boolean  @default(true)
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()

  @@index([employerId])
  @@index([userId])
}

model CalendarEvent {
  id                    String   @id
  employerId            String
  employer              EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  interviewId           String?
  interview             JobInterview?    @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  title                 String
  description           String?
  eventType             String   @default("interview")
  startTime             TimestamptzString
  endTime               TimestamptzString
  timezone              String   @default("UTC")
  location              String?
  meetingUrl            String?
  status                String   @default("confirmed")
  attendees                String[] @default([])
  organizerEmail           String?
  sequence                 Int      @default(0)
  googleCalendarEventId    String?
  microsoftCalendarEventId String?
  iCalUid                  String?
  metadata                 String?
  createdAt                TimestamptzString @default(now())
  updatedAt                temporal.updatedAtString()

  @@index([employerId])
  @@index([interviewId])
  @@index([startTime])
  @@index([status])
}

model CalendarIntegration {
  id               String   @id
  employerId       String
  employer         EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  userId           String?
  provider         String
  accountEmail     String?
  calendarId       String?  @default("primary")
  calendarName     String?
  accessToken      String?
  refreshToken     String?
  expiresAt        TimestamptzString?
  syncEnabled      Boolean  @default(true)
  syncDirection    String   @default("bidirectional")
  lastSyncedAt     TimestamptzString?
  syncStatus       String   @default("connected")
  syncError        String?
  webhookId        String?
  webhookSecret    String?
  webhookExpiresAt TimestamptzString?
  metadata         String?
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@unique([employerId, provider])
  @@index([employerId])
  @@index([provider])
  @@index([syncStatus])
}

